generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma-client"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ListingCondition {
  NEW
  USED_LIKE_NEW
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  COMPLETED
  CANCELLED
  RETURNED
}
// -----------------------------------------------------------------------------
// Payment domain enums
// -----------------------------------------------------------------------------
enum PaymentProvider {
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// Cancellation metadata enums
enum CancellationInitiator {
  CUSTOMER
  SELLER
}

enum CancellationReason {
  CHANGED_MIND
  ORDERED_BY_MISTAKE
  ADDRESS_PROBLEM
  FOUND_CHEAPER_ELSEWHERE
  OTHER
  OUT_OF_STOCK
  PRICING_ERROR
  PRODUCT_UNAVAILABLE
  FULFILMENT_ISSUE
}

enum InventoryMovementType {
  PURCHASE_IN
  WEBSITE_SALE
  ORDER_RETURN
  ORDER_CANCELLATION_RETURN
  FBA_OUTBOUND
  DAMAGE_ADJUSTMENT
  MANUAL_ADJUSTMENT
  PURCHASE_RETURN_OUT
}

enum OrderReturnStatus {
  REQUESTED
  AUTHORIZED
  RECEIVED
  INSPECTED
  COMPLETED
  REJECTED
  CANCELLED
}

enum ReturnReason {
  CHANGE_OF_MIND
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  OTHER
}

enum ReturnShippingPayer {
  CUSTOMER
  SELLER
}

enum ReturnCondition {
  AS_NEW
  OPENED_COMPLETE
  DAMAGED
  INCOMPLETE
  WRONG_ITEM_RETURNED
  OTHER
}

// -----------------------------------------------------------------------------
// Business expense domain enums
// -----------------------------------------------------------------------------
enum BusinessExpenseCategory {
  PURCHASE
  SHIPPING
  PLATFORM_FEE
  PACKAGING
  OTHER
}

enum BusinessExpenseSourceType {
  MANUAL
}

// -----------------------------------------------------------------------------
// BusinessExpense model
// -----------------------------------------------------------------------------
model BusinessExpense {
  id          Int                      @id @default(autoincrement())
  category    BusinessExpenseCategory
  amount      Decimal                  @db.Decimal(12,2)
  incurredAt  DateTime
  description String?
  sourceType  BusinessExpenseSourceType
  sourceId    Int?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}
model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  passwordHash       String
  emailVerified      Boolean             @default(false)
  role               UserRole            @default(CUSTOMER)
  firstName          String?
  lastName           String?
  phone              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  addresses          Address[]
  inventoryMovements InventoryMovement[]
  purchaseDocuments PurchaseDocument[]
  orders Order[]
  orderReturns OrderReturn[]
  inspectedOrderReturns OrderReturn[] @relation("OrderReturnInspectedBy")
}

model Address {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  line1         String
  line2         String?
  city          String
  county        String?
  postcode      String
  countryCode   String
  phone         String?
  isDefault     Boolean   @default(false)
  // Separate default billing flag, used for the new API.
  isDefaultBilling Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([userId])
}

model LegoProduct {
  id               Int                @id @default(autoincrement())
  setNumber        String             @unique
  title            String
  description      String?
  theme            String
  ageRecommendation String
  pieceCount       Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  productListings  ProductListing[]
  @@index([theme])
}

model ProductListing {
  id           Int                @id @default(autoincrement())
  legoProductId Int
  legoProduct   LegoProduct        @relation(fields: [legoProductId], references: [id])
  condition    ListingCondition
  originalPrice Decimal          @db.Decimal(10,2)
  salePrice    Decimal?          @db.Decimal(10,2)
  currentStock Int                @default(0)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  listingImages ListingImage[]
  inventoryMovements InventoryMovement[]
  purchaseItems PurchaseItem[]
  orderItems OrderItem[]
  @@index([legoProductId])
  @@index([condition])
  @@index([active])
}

model ListingImage {
  id        Int      @id @default(autoincrement())
  listingId Int
  listing   ProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  @@index([listingId])
  @@index([listingId, sortOrder])
}

model InventoryMovement {
  id                Int                    @id @default(autoincrement())
  listingId         Int
  listing           ProductListing         @relation(fields: [listingId], references: [id], onDelete: Restrict)
  quantityChange    Int
  type              InventoryMovementType
  note              String
  performedByUserId Int
  performedByUser   User                   @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime               @default(now())
  @@index([listingId])
  @@index([performedByUserId])
  @@index([createdAt])
  @@index([type])
}

model Order {
  id                Int                @id @default(autoincrement())
  userId            Int
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  status            OrderStatus        @default(PENDING)
  // Billing address snapshot – comes from the user's saved/default address
  billingRecipientName String
  billingLine1         String
  billingLine2         String?
  billingCity          String
  billingCounty        String?
  billingPostcode      String
  billingCountryCode   String
  billingPhone         String?

  // Delivery address snapshot – defaults to billing but can be overridden
  deliveryRecipientName String
  deliveryLine1         String
  deliveryLine2         String?
  deliveryCity          String
  deliveryCounty        String?
  deliveryPostcode      String
  deliveryCountryCode   String
  deliveryPhone         String?
  totalAmount       Decimal            @db.Decimal(12,2)
  // Shipping details – only visible to admins
  actualShippingCost Decimal?           @db.Decimal(10,2)
  shippingCarrier   String?
  trackingNumber    String?
  dispatchedAt      DateTime?
  createdAt         DateTime           @default(now())
  // Cancellation metadata – optional until cancellation occurs
  cancelledAt           DateTime?
  cancelledBy           CancellationInitiator?
  cancellationReason    CancellationReason?
  completedAt          DateTime?          @db.Timestamptz
  updatedAt         DateTime           @updatedAt
  @@index([userId])
  orderItems        OrderItem[]
  payments          Payment[]
}

// -----------------------------------------------------------------------------
// Payment domain model
// -----------------------------------------------------------------------------
model Payment {
  id                Int              @id @default(autoincrement())
  orderId           Int
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount            Decimal          @db.Decimal(12,2)
  currency          String @db.VarChar(3) @default("GBP")
  provider          PaymentProvider  @default(MANUAL)
  providerReference String
  status            PaymentStatus    @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([provider, providerReference])
  @@index([orderId])
}

model OrderItem {
  id                Int                @id @default(autoincrement())
  orderId           Int
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productListingId  Int
  productListing    ProductListing     @relation(fields: [productListingId], references: [id], onDelete: Restrict)
  quantity          Int
  returnedQuantity  Int                @default(0)
  unitPrice         Decimal            @db.Decimal(10,2)
  lineTotal         Decimal            @db.Decimal(12,2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  returns           OrderReturn[]
  @@index([orderId])
  @@index([productListingId])
}

model OrderReturn {
  id                Int       @id @default(autoincrement())
  orderItemId       Int
  orderItem         OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity          Int
  restockQuantity   Int                @default(0)
  reason            ReturnReason
  reasonNote        String?
  status            OrderReturnStatus   @default(REQUESTED)
  shippingPayer     ReturnShippingPayer?
  returnShippingCost Decimal?           @db.Decimal(10, 2)
  performedByUserId Int
  performedByUser   User      @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)
  condition         ReturnCondition?
  inspectionNote    String?
  inspectedAt       DateTime?
  inspectedByUserId Int?
  inspectedByUser   User?     @relation("OrderReturnInspectedBy", fields: [inspectedByUserId], references: [id], onDelete: Restrict)
  requestedAt       DateTime  @default(now())
  authorizedAt      DateTime?
  receivedAt        DateTime?
  completedAt       DateTime?
  rejectedAt        DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([orderItemId])
  @@index([status])
  @@index([performedByUserId])
  @@index([inspectedByUserId])
  @@index([requestedAt])
}

model Purchase {
  id                   Int                @id @default(autoincrement())
  sourceOrderReference String             @unique
  sourceOrderDate      DateTime?
  merchantName         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  purchaseDocuments    PurchaseDocument[]
}

model PurchaseDocument {
  id                            Int            @id @default(autoincrement())
  purchaseId                    Int
  purchase                      Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  partNumber                    Int
  sourceInvoiceReference        String?
  importHash                    String         @db.VarChar(64) @unique
  sourceDocumentDate            DateTime?

  importedByUserId              Int
  importedByUser                User           @relation(fields: [importedByUserId], references: [id], onDelete: Restrict)

  originalGrossMerchandiseTotal Decimal        @db.Decimal(12,2)
  shippingTotal                 Decimal        @db.Decimal(12,2) @default(0.00)
  discountTotal                 Decimal        @db.Decimal(12,2) @default(0.00)
  finalTotalPaid                Decimal        @db.Decimal(12,2)

  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt

  purchaseItems                 PurchaseItem[]

  @@unique([purchaseId, partNumber])
  @@index([purchaseId])
  @@index([importedByUserId])
}

model PurchaseItem {
  id                        Int                 @id @default(autoincrement())

  purchaseDocumentId        Int
  purchaseDocument          PurchaseDocument    @relation(fields: [purchaseDocumentId], references: [id], onDelete: Restrict)

  productListingId          Int?
  productListing            ProductListing?     @relation(fields: [productListingId], references: [id], onDelete: SetNull)

  externalProductId         String?
  sourceDescription         String
  sourceSetNumber           String?
  sourceLineNumber          Int?

  quantity                  Int

  originalGrossUnitCost     Decimal             @db.Decimal(12,2)
  originalGrossLineTotal    Decimal             @db.Decimal(12,2)

  allocatedShipping         Decimal             @db.Decimal(12,2) @default(0.00)
  allocatedDiscount         Decimal             @db.Decimal(12,2) @default(0.00)

  finalLineCost             Decimal             @db.Decimal(12,2)
  finalUnitCost             Decimal             @db.Decimal(14,6)

  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  receivedAt DateTime?

  // Timestamp marking when this item was returned to the supplier.
  returnedAt DateTime?

  @@index([purchaseDocumentId])
  @@index([productListingId])
  @@index([externalProductId])
  @@index([sourceSetNumber])
}
